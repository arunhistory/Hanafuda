{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "v3-src",
    "outDir": "v3-dist",
    "verbatimModuleSyntax": true,
    "removeComments": false
  },
  "include": ["v3-src/**/*.ts"]
}
